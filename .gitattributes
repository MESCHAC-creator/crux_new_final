# Gradle wrapper must stay LF + executable for Linux CI (Codemagic, GitHub Actions)
android/gradlew text eol=lf
android/gradlew.bat text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf

# Force jar files to be treated as binary to prevent corruption during transfers/Git operations
*.jar binary
android/gradle/wrapper/gradle-wrapper.jar binary

